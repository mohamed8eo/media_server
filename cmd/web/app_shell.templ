package web

import "github.com/bryanvaz/go-templ-lucide-icons"

templ AppShell(currentPage string) {
	@Base() {
		<div class="flex min-h-screen bg-background">
			@Sidebar(currentPage)
			<div class="flex flex-1 flex-col pl-64">
				<!-- Top bar -->
				<header class="sticky top-0 z-40 flex h-14 items-center gap-4 border-b px-6 border-border bg-card/80 backdrop-blur-md">
					<div class="flex-1"></div>
					<button onclick="toggleTheme()" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 w-9">
						@icons.Moon(templ.Attributes{"class": "h-4 w-4 block dark:hidden"})
						@icons.Sun(templ.Attributes{"class": "h-4 w-4 hidden dark:block"})
					</button>
					<a href="/api/auth/logout" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 w-9">
						@icons.LogOut(templ.Attributes{"class": "h-4 w-4"})
					</a>
				</header>
				<main class="flex-1 gap-4 p-6 md:gap-8">
					{ children... }
				</main>
			</div>
		</div>
		<script>
			function toggleTheme() {
				if (document.documentElement.classList.contains('dark')) {
					document.documentElement.classList.remove('dark');
					localStorage.theme = 'light';
				} else {
					document.documentElement.classList.add('dark');
					localStorage.theme = 'dark';
				}
			}
		</script>
	}
}
