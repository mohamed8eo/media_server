package web

import "github.com/bryanvaz/go-templ-lucide-icons"

templ AppShell(currentPage string, title string, subtitle string) {
	@Base() {
		<div class="flex flex-col min-h-screen bg-background text-slate-900 dark:text-slate-100">
			<!-- Top Navigation Bar -->
<header class="sticky top-0 z-40 flex h-16 items-center gap-x-2 sm:gap-x-3 border-b border-border bg-white/80 px-3 backdrop-blur-md dark:border-slate-800 dark:bg-slate-900/80 sm:px-6">
			<!-- Left: Logo + Desktop Category Navigation Pills -->
			<div class="flex min-w-0 flex-none items-center gap-3 lg:gap-8">
					<a href="/" class="flex min-w-0 items-center gap-2 sm:gap-2.5">
						<img src="/assets/icons/icon-192.png" alt="Trove" class="h-8 w-8 shrink-0 rounded-lg object-cover shadow-sm"/>
						<span class="truncate text-base font-bold tracking-tight text-slate-900 dark:text-slate-100 sm:text-lg">Trove</span>
					</a>
					<nav class="hidden lg:flex items-center gap-1 border border-border dark:border-slate-800 rounded-xl p-1 bg-muted/50 h-10" id="top-nav">
						<a href="/" hx-get="/" hx-target="#main-content" hx-swap="innerHTML transition:true" hx-push-url="true" data-nav="all" class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg text-sm font-medium transition-colors px-3 h-8 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100">
							@icons.Layers(templ.Attributes{"class": "h-4 w-4"})
							All
						</a>
						<a href="/?type=video" hx-get="/?type=video" hx-target="#main-content" hx-swap="innerHTML transition:true" hx-push-url="true" data-nav="video" class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg text-sm font-medium transition-colors px-3 h-8 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100">
							@icons.Video(templ.Attributes{"class": "h-4 w-4"})
							Videos
						</a>
						<a href="/?type=image" hx-get="/?type=image" hx-target="#main-content" hx-swap="innerHTML transition:true" hx-push-url="true" data-nav="image" class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg text-sm font-medium transition-colors px-3 h-8 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100">
							@icons.Image(templ.Attributes{"class": "h-4 w-4"})
							Images
						</a>
						<a href="/?type=document" hx-get="/?type=document" hx-target="#main-content" hx-swap="innerHTML transition:true" hx-push-url="true" data-nav="document" class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg text-sm font-medium transition-colors px-3 h-8 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100">
							@icons.FileText(templ.Attributes{"class": "h-4 w-4"})
							Docs
						</a>
					</nav>
				</div>

				<!-- Center-Right: Search Input Box -->
				<div class="flex min-w-0 flex-1 items-center lg:max-w-sm">
					<div class="relative w-full">
						@icons.Search(templ.Attributes{"class": "absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"})
						<input
							type="text"
							id="file-search"
							placeholder="Search files & folders..."
							class="flex h-9 w-full rounded-xl border border-input dark:border-slate-800 bg-background dark:bg-slate-900/60 pl-9 pr-3 py-2 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
						/>
					</div>
				</div>

				<!-- Far Right: Action Controls -->
				<div class="ml-auto flex shrink-0 items-center gap-2 sm:gap-2.5">
					<button onclick="createNewFolder()" class="hidden lg:inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl text-sm font-medium transition-colors border border-input dark:border-slate-800 bg-background dark:bg-slate-900/60 shadow-sm hover:bg-accent hover:text-accent-foreground h-9 px-3.5 cursor-pointer" title="New Folder">
						@icons.FolderPlus(templ.Attributes{"class": "h-4 w-4"})
						<span>New Folder</span>
					</button>
					<a href="/upload" data-nav="upload" class="hidden lg:inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-xl text-sm font-medium transition-colors bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-3.5 cursor-pointer" title="Upload">
						@icons.Upload(templ.Attributes{"class": "h-4 w-4"})
						<span>Upload</span>
					</a>
					<button onclick="toggleTheme()" class="inline-flex items-center justify-center rounded-xl text-sm font-medium transition-colors border border-input dark:border-slate-800 bg-background dark:bg-slate-900 shadow-sm hover:bg-accent dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 h-9 w-9 cursor-pointer" title="Toggle theme">
						@icons.Moon(templ.Attributes{"class": "h-4 w-4 block dark:hidden", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
						@icons.Sun(templ.Attributes{"class": "h-4 w-4 hidden dark:block", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
					</button>
					<a href="/settings" data-nav="settings" class="hidden lg:inline-flex items-center justify-center rounded-xl text-sm font-medium transition-colors border border-input dark:border-slate-800 bg-background dark:bg-slate-900 shadow-sm hover:bg-accent dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 h-9 w-9 cursor-pointer" title="Settings">
						@icons.Settings(templ.Attributes{"class": "h-4 w-4", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
					</a>
					<a href="/api/auth/logout" class="hidden lg:inline-flex items-center justify-center rounded-xl text-sm font-medium transition-colors border border-input dark:border-slate-800 bg-background dark:bg-slate-900 shadow-sm hover:bg-accent dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 h-9 w-9 cursor-pointer" title="Sign out">
						@icons.LogOut(templ.Attributes{"class": "h-4 w-4", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
					</a>
					<!-- Mobile burger menu -->
					<div x-data="{ menuOpen: false }" @click.outside="menuOpen = false" class="relative lg:hidden">
						<button @click="menuOpen = !menuOpen" @keydown.escape.window="menuOpen = false" class="inline-flex items-center justify-center rounded-xl text-sm font-medium transition-colors border border-input dark:border-slate-800 bg-background dark:bg-slate-900 shadow-sm hover:bg-accent dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 h-9 w-9 cursor-pointer" title="Menu">
							@icons.Menu(templ.Attributes{"class": "h-4 w-4", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
						</button>
						<div x-show="menuOpen" x-transition style="display: none;" class="absolute right-0 top-full mt-2 w-52 rounded-xl bg-card border border-border dark:border-slate-800 shadow-2xl z-[100] p-1 text-xs font-medium">
							<button onclick="createNewFolder()" @click="menuOpen = false" class="w-full text-left px-3.5 py-2 rounded-lg hover:bg-accent hover:text-accent-foreground flex items-center gap-2 cursor-pointer">
								@icons.FolderPlus(templ.Attributes{"class": "h-4 w-4", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
								New Folder
							</button>
							<a href="/upload" @click="menuOpen = false" class="w-full text-left px-3.5 py-2 rounded-lg hover:bg-accent hover:text-accent-foreground flex items-center gap-2">
								@icons.Upload(templ.Attributes{"class": "h-4 w-4", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
								Upload
							</a>
							<a href="/settings" @click="menuOpen = false" class="w-full text-left px-3.5 py-2 rounded-lg hover:bg-accent hover:text-accent-foreground flex items-center gap-2">
								@icons.Settings(templ.Attributes{"class": "h-4 w-4", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
								Settings
							</a>
							<a href="/api/auth/logout" class="w-full text-left px-3.5 py-2 rounded-lg text-destructive hover:bg-destructive/10 flex items-center gap-2">
								@icons.LogOut(templ.Attributes{"class": "h-4 w-4", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
								Sign out
							</a>
						</div>
					</div>
				</div>
			</header>

			<!-- Main Content Wrapper -->
			<main id="main-content" hx-on::after-swap="if(typeof initFileBrowser === 'function') initFileBrowser(); if(typeof updateNavActive === 'function') updateNavActive();" class="min-w-0 flex-1 space-y-6 overflow-x-hidden p-3 pb-24 sm:p-6 sm:pb-24 md:p-8 md:pb-8">
				if title != "" {
					<div class="mb-7 grid grid-cols-[minmax(0,1fr)_auto] items-end gap-4">
						<div class="min-w-0">
							<p class="mb-1 text-sm text-muted-foreground">Trove <span class="mx-1">/</span> { title }</p>
							<h1 class="truncate text-2xl font-bold sm:text-3xl text-slate-900 dark:text-slate-100">{ title }</h1>
							if subtitle != "" {
								<p class="mt-1 text-sm text-muted-foreground">{ subtitle }</p>
							}
						</div>
					</div>
				}
				{ children... }
			</main>

			<!-- Mobile Bottom Navigation Bar -->
			<nav class="fixed inset-x-0 bottom-0 z-40 flex h-16 items-center justify-around border-t border-slate-200 bg-white/90 pb-[env(safe-area-inset-bottom)] backdrop-blur-lg dark:border-slate-800 dark:bg-slate-900/90 md:hidden" id="mobile-bottom-nav">
				<a href="/" hx-get="/" hx-target="#main-content" hx-swap="innerHTML transition:true" hx-push-url="true" data-nav="all" class="flex flex-col items-center justify-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors w-12 h-full">
					@icons.LayoutGrid(templ.Attributes{"class": "h-5 w-5"})
					<span>All</span>
				</a>
				<a href="/?type=video" hx-get="/?type=video" hx-target="#main-content" hx-swap="innerHTML transition:true" hx-push-url="true" data-nav="video" class="flex flex-col items-center justify-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors w-12 h-full">
					@icons.Video(templ.Attributes{"class": "h-5 w-5"})
					<span>Videos</span>
				</a>
				<a href="/?type=image" hx-get="/?type=image" hx-target="#main-content" hx-swap="innerHTML transition:true" hx-push-url="true" data-nav="image" class="flex flex-col items-center justify-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors w-12 h-full">
					@icons.Image(templ.Attributes{"class": "h-5 w-5"})
					<span>Images</span>
				</a>
				<a href="/?type=document" hx-get="/?type=document" hx-target="#main-content" hx-swap="innerHTML transition:true" hx-push-url="true" data-nav="document" class="flex flex-col items-center justify-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors w-12 h-full">
					@icons.FileText(templ.Attributes{"class": "h-5 w-5"})
					<span>Docs</span>
				</a>
				<a href="/upload" data-nav="upload" class="flex flex-col items-center justify-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors w-12 h-full">
					@icons.Upload(templ.Attributes{"class": "h-5 w-5"})
					<span>Upload</span>
				</a>
			</nav>
		</div>
		<script>
			function toggleTheme() {
				if (document.documentElement.classList.contains('dark')) {
					document.documentElement.classList.remove('dark');
					localStorage.theme = 'light';
				} else {
					document.documentElement.classList.add('dark');
					localStorage.theme = 'dark';
				}
			}

			function updateNavActive() {
				const params = new URLSearchParams(window.location.search);
				const type = params.get('type');
				const path = window.location.pathname;
				let active = 'all';
				if (path === '/upload') active = 'upload';
				else if (path === '/settings') active = 'settings';
				else if (path.startsWith('/watch/')) active = 'video';
				else if (type === 'video') active = 'video';
				else if (type === 'image') active = 'image';
				else if (type === 'document') active = 'document';

				document.querySelectorAll('#top-nav a[data-nav]').forEach(link => {
					if (link.dataset.nav === active) {
						link.className = 'inline-flex items-center gap-2 whitespace-nowrap rounded-lg text-sm font-medium transition-colors px-3 h-8 bg-background dark:bg-slate-800 text-slate-900 dark:text-slate-100 shadow-sm';
					} else {
						link.className = 'inline-flex items-center gap-2 whitespace-nowrap rounded-lg text-sm font-medium transition-colors px-3 h-8 text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-slate-100';
					}
				});

				document.querySelectorAll('#mobile-bottom-nav a[data-nav]').forEach(link => {
					if (link.dataset.nav === active) {
						link.className = 'flex flex-col items-center justify-center gap-1 text-xs font-semibold text-primary dark:text-primary-foreground transition-colors w-12 h-full';
					} else {
						link.className = 'flex flex-col items-center justify-center gap-1 text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100 transition-colors w-12 h-full';
					}
				});
			}
			updateNavActive();
			window.addEventListener('popstate', updateNavActive);
		</script>
		<script src={ "/assets/js/browser.js?v=" + AssetVersion }></script>
		<script src={ "/assets/js/upload.js?v=" + AssetVersion }></script>
	}
}
