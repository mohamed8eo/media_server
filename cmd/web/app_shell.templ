package web

import "github.com/bryanvaz/go-templ-lucide-icons"

templ AppShell(currentPage string) {
	@Base() {
		<div x-data="{ mobileOpen: false }" class="flex min-h-screen bg-background text-slate-900 dark:text-slate-100">
			<!-- Mobile drawer backdrop -->
			<div 
				x-show="mobileOpen" 
				x-transition.opacity 
				@click="mobileOpen = false" 
				class="fixed inset-0 z-50 bg-black/50 backdrop-blur-sm lg:hidden"
				style="display: none;"
			></div>

			<!-- Mobile slide-out drawer -->
			<div 
				x-show="mobileOpen" 
				x-transition:enter="transition ease-out duration-250 transform"
				x-transition:enter-start="-translate-x-full"
				x-transition:enter-end="translate-x-0"
				x-transition:leave="transition ease-in duration-200 transform"
				x-transition:leave-start="translate-x-0"
				x-transition:leave-end="-translate-x-full"
				class="fixed inset-y-0 left-0 z-50 flex w-72 flex-col border-r bg-card border-border dark:bg-[#0d1322] dark:border-slate-800/80 lg:hidden shadow-2xl"
				style="display: none;"
			>
				<div class="flex h-14 items-center justify-between border-b px-5 border-border dark:border-slate-800/80">
					<div class="flex items-center gap-2.5">
						<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-sm">
							@icons.Play(templ.Attributes{"class": "h-4 w-4"})
						</div>
						<span class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100">MediaVault</span>
					</div>
					<button @click="mobileOpen = false" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input bg-background dark:bg-slate-900 shadow-sm hover:bg-accent h-8 w-8 text-slate-700 dark:text-slate-200">
						@icons.X(templ.Attributes{"class": "h-4 w-4"})
					</button>
				</div>
				<!-- Mobile nav links -->
				<nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1.5" id="mobile-sidebar-nav">
					<a href="/" @click="mobileOpen = false" data-nav="all" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
						@icons.Library(templ.Attributes{"class": "h-4 w-4"})
						All Media
					</a>
					<a href="/?type=video" @click="mobileOpen = false" data-nav="video" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
						@icons.Video(templ.Attributes{"class": "h-4 w-4"})
						Videos
					</a>
					<a href="/?type=image" @click="mobileOpen = false" data-nav="image" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
						@icons.Image(templ.Attributes{"class": "h-4 w-4"})
						Images
					</a>
					<a href="/?type=document" @click="mobileOpen = false" data-nav="document" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
						@icons.FileText(templ.Attributes{"class": "h-4 w-4"})
						Documents
					</a>
					<a href="/upload" @click="mobileOpen = false" data-nav="upload" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
						@icons.Upload(templ.Attributes{"class": "h-4 w-4"})
						Upload
					</a>
				</nav>
				<div class="border-t px-3 py-4 space-y-1 border-border dark:border-slate-800/80">
					<a href="/settings" @click="mobileOpen = false" data-nav="settings" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
						@icons.Settings(templ.Attributes{"class": "h-4 w-4"})
						Settings
					</a>
				</div>
			</div>

			<!-- Desktop Sidebar -->
			<div class="hidden lg:block lg:w-64 lg:shrink-0">
				@Sidebar(currentPage)
			</div>

			<div class="flex flex-1 flex-col min-w-0">
				<!-- Top bar -->
				<header class="sticky top-0 z-40 flex h-14 items-center justify-between px-4 sm:px-6 border-b border-border dark:border-slate-800/80 bg-card/80 dark:bg-[#0d1322]/80 backdrop-blur-md">
					<div class="flex items-center gap-3">
						<button @click="mobileOpen = true" class="inline-flex lg:hidden items-center justify-center rounded-md text-sm font-medium transition-colors border border-input dark:border-slate-700 bg-background dark:bg-slate-900 shadow-sm hover:bg-accent dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 h-9 w-9 cursor-pointer" title="Open menu">
							@icons.Menu(templ.Attributes{"class": "h-4 w-4"})
						</button>
						<div class="flex items-center gap-2.5 lg:hidden">
							<div class="flex h-7 w-7 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-sm">
								@icons.Play(templ.Attributes{"class": "h-3.5 w-3.5"})
							</div>
							<span class="text-base font-bold tracking-tight text-slate-900 dark:text-slate-100">MediaVault</span>
						</div>
					</div>
					<div class="flex items-center gap-2">
						<button onclick="toggleTheme()" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input dark:border-slate-700 bg-background dark:bg-slate-900 shadow-sm hover:bg-accent dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 h-9 w-9 cursor-pointer" title="Toggle theme">
							@icons.Moon(templ.Attributes{"class": "h-4 w-4 block dark:hidden", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
							@icons.Sun(templ.Attributes{"class": "h-4 w-4 hidden dark:block", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
						</button>
						<a href="/api/auth/logout" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors border border-input dark:border-slate-700 bg-background dark:bg-slate-900 shadow-sm hover:bg-accent dark:hover:bg-slate-800 text-slate-700 dark:text-slate-200 h-9 w-9 cursor-pointer" title="Sign out">
							@icons.LogOut(templ.Attributes{"class": "h-4 w-4", "stroke": "currentColor", "stroke-width": "2", "fill": "none"})
						</a>
					</div>
				</header>
				<main class="flex-1 p-4 sm:p-6 md:p-8 space-y-6">
					{ children... }
				</main>
			</div>
		</div>
		<script>
			function toggleTheme() {
				if (document.documentElement.classList.contains('dark')) {
					document.documentElement.classList.remove('dark');
					localStorage.theme = 'light';
				} else {
					document.documentElement.classList.add('dark');
					localStorage.theme = 'dark';
				}
			}
		</script>
	}
}
