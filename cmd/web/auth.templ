package web

templ SignUp() {
	@Base() {
		<div class="min-h-screen bg-gradient-to-br from-sky-300 via-sky-100 to-indigo-200 flex items-center justify-center p-4">
			<div class="max-w-md w-full bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/60 p-8 space-y-8">
				<div class="text-center space-y-3">
					<div class="w-14 h-14 mx-auto bg-white rounded-2xl shadow-md border border-slate-100 flex items-center justify-center text-slate-800">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
						</svg>
					</div>
					<h2 class="text-2xl font-bold tracking-tight text-slate-900">Create an account</h2>
					<p class="text-sm text-slate-500">Sign up to get started with your media server</p>
				</div>

				<form class="space-y-5" hx-post="/api/auth/register" hx-target="#auth-response" hx-swap="innerHTML" hx-indicator="#spinner" hx-on::after-request="handleAuthResponse(event)">
					<div class="space-y-4">
						<div>
							<label for="email" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Email</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
									</svg>
								</div>
								<input id="email" name="email" type="email" autocomplete="email" required 
									oninput="localStorage.setItem('auth_email', this.value)"
									class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all" placeholder="name@example.com"/>
							</div>
						</div>
						<div>
							<label for="password" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Password</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
									</svg>
								</div>
								<input id="password" name="password" type="password" autocomplete="new-password" required 
									onfocus="document.getElementById('password-requirements').classList.remove('hidden')"
									oninput="checkPassword(this.value)"
									class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all" placeholder="••••••••"/>
							</div>
							<div id="password-requirements" class="hidden mt-2 p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2 text-xs text-slate-600">
								<p class="font-semibold text-slate-700">Password requirements:</p>
								<div id="req-length" data-text="At least 8 characters" class="text-slate-400 flex items-center"><span class="text-slate-300 font-bold mr-1.5">○</span> At least 8 characters</div>
								<div id="req-upper" data-text="One uppercase letter (A-Z)" class="text-slate-400 flex items-center"><span class="text-slate-300 font-bold mr-1.5">○</span> One uppercase letter (A-Z)</div>
								<div id="req-lower" data-text="One lowercase letter (a-z)" class="text-slate-400 flex items-center"><span class="text-slate-300 font-bold mr-1.5">○</span> One lowercase letter (a-z)</div>
								<div id="req-special" data-text="One special character or number" class="text-slate-400 flex items-center"><span class="text-slate-300 font-bold mr-1.5">○</span> One special character or number</div>
							</div>
						</div>
					</div>

					<div id="inline-error" class="hidden text-xs font-medium text-red-600 bg-red-50 p-2.5 rounded-lg border border-red-100 text-center"></div>

					<div>
						<button type="submit" class="w-full flex items-center justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-xl text-white bg-slate-900 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 shadow-lg shadow-slate-900/15 transition-all cursor-pointer">
							<span>Create Account</span>
							<svg id="spinner" class="htmx-indicator animate-spin ml-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</button>
					</div>

					<div class="text-center text-sm text-slate-600">
						Already have an account? 
						<a href="/sign-in" class="font-semibold text-slate-900 hover:underline transition-colors">Sign in</a>
					</div>

					<div id="auth-response"></div>
				</form>
			</div>
		</div>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const savedEmail = localStorage.getItem('auth_email');
				if (savedEmail) {
					const emailInput = document.getElementById('email');
					if (emailInput) emailInput.value = savedEmail;
				}
			});

			function checkPassword(password) {
				const minLength = password.length >= 8;
				const hasUpper = /[A-Z]/.test(password);
				const hasLower = /[a-z]/.test(password);
				const hasSpecial = /[^A-Za-z0-9]/.test(password);

				updateReq('req-length', minLength);
				updateReq('req-upper', hasUpper);
				updateReq('req-lower', hasLower);
				updateReq('req-special', hasSpecial);
			}

			function updateReq(id, isValid) {
				const el = document.getElementById(id);
				if (!el) return;
				const text = el.getAttribute('data-text');
				if (isValid) {
					el.className = "text-emerald-600 font-medium flex items-center";
					el.innerHTML = '<span class="text-emerald-500 font-bold mr-1.5">✓</span> ' + text;
				} else {
					el.className = "text-slate-400 flex items-center";
					el.innerHTML = '<span class="text-slate-300 font-bold mr-1.5">○</span> ' + text;
				}
			}

			function handleAuthResponse(evt) {
				const xhr = evt.detail.xhr;
				const emailInput = document.getElementById('email');
				const passwordInput = document.getElementById('password');
				const inlineError = document.getElementById('inline-error');
				const authResponse = document.getElementById('auth-response');
				if (xhr.status >= 400) {
					if (emailInput) emailInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (passwordInput) passwordInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (inlineError) {
						const tempDiv = document.createElement('div');
						tempDiv.innerHTML = xhr.responseText;
						const span = tempDiv.querySelector('span');
						inlineError.textContent = span ? span.textContent : "Invalid email or password";
						inlineError.classList.remove('hidden');
					}
					// Keep a single error surface; don't leave a duplicate HTMX swap behind.
					if (authResponse) authResponse.innerHTML = '';
				} else {
					if (emailInput) {
						emailInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (passwordInput) {
						passwordInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (inlineError) {
						inlineError.textContent = '';
						inlineError.classList.add('hidden');
					}
					localStorage.removeItem('auth_email');
				}
			}
		</script>
	}
}

templ SignIn() {
	@Base() {
		<div class="min-h-screen bg-gradient-to-br from-sky-300 via-sky-100 to-indigo-200 flex items-center justify-center p-4">
			<div class="max-w-md w-full bg-white/95 backdrop-blur-xl rounded-3xl shadow-2xl border border-white/60 p-8 space-y-8">
				<div class="text-center space-y-3">
					<div class="w-14 h-14 mx-auto bg-white rounded-2xl shadow-md border border-slate-100 flex items-center justify-center text-slate-800">
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path>
						</svg>
					</div>
					<h2 class="text-2xl font-bold tracking-tight text-slate-900">Sign in to your account</h2>
					<p class="text-sm text-slate-500">Welcome back! Please enter your details.</p>
				</div>

				<form class="space-y-5" hx-post="/api/auth/login" hx-target="#auth-response" hx-swap="innerHTML" hx-indicator="#spinner" hx-on::after-request="handleAuthResponse(event)">
					<div class="space-y-4">
						<div>
							<label for="email" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Email</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
									</svg>
								</div>
								<input id="email" name="email" type="email" autocomplete="email" required 
									oninput="localStorage.setItem('auth_email', this.value)"
									class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all" placeholder="name@example.com"/>
							</div>
						</div>
						<div>
							<label for="password" class="block text-xs font-semibold text-slate-600 uppercase tracking-wider mb-1.5">Password</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									<svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
									</svg>
								</div>
								<input id="password" name="password" type="password" autocomplete="current-password" required class="w-full pl-11 pr-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 focus:bg-white transition-all" placeholder="••••••••"/>
							</div>
						</div>
					</div>

					<div id="inline-error" class="hidden text-xs font-medium text-red-600 bg-red-50 p-2.5 rounded-lg border border-red-100 text-center"></div>

					<div>
						<button type="submit" class="w-full flex items-center justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-xl text-white bg-slate-900 hover:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-slate-900 shadow-lg shadow-slate-900/15 transition-all cursor-pointer">
							<span>Sign In</span>
							<svg id="spinner" class="htmx-indicator animate-spin ml-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</button>
					</div>

					<div class="text-center text-sm text-slate-600">
						Don't have an account? 
						<a href="/sign-up" class="font-semibold text-slate-900 hover:underline transition-colors">Create account</a>
					</div>

					<div id="auth-response"></div>
				</form>
			</div>
		</div>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const savedEmail = localStorage.getItem('auth_email');
				if (savedEmail) {
					const emailInput = document.getElementById('email');
					if (emailInput) emailInput.value = savedEmail;
				}
			});

			function handleAuthResponse(evt) {
				const xhr = evt.detail.xhr;
				const emailInput = document.getElementById('email');
				const passwordInput = document.getElementById('password');
				const inlineError = document.getElementById('inline-error');
				const authResponse = document.getElementById('auth-response');
				if (xhr.status >= 400) {
					if (emailInput) emailInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (passwordInput) passwordInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (inlineError) {
						const tempDiv = document.createElement('div');
						tempDiv.innerHTML = xhr.responseText;
						const span = tempDiv.querySelector('span');
						inlineError.textContent = span ? span.textContent : "Invalid email or password";
						inlineError.classList.remove('hidden');
					}
					// Keep a single error surface; don't leave a duplicate HTMX swap behind.
					if (authResponse) authResponse.innerHTML = '';
				} else {
					if (emailInput) {
						emailInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (passwordInput) {
						passwordInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (inlineError) {
						inlineError.textContent = '';
						inlineError.classList.add('hidden');
					}
					localStorage.removeItem('auth_email');
				}
			}
		</script>
	}
}
