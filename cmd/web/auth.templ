package web

templ SignIn() {
	@Base() {
		<div class="min-h-screen bg-background flex items-center justify-center p-4">
			<div class="max-w-md w-full bg-card border border-border rounded-3xl shadow-2xl p-8 space-y-6 text-card-foreground">
				<div class="text-center space-y-2">
					<div class="w-14 h-14 mx-auto bg-primary text-primary-foreground rounded-2xl shadow-md flex items-center justify-center">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"></path>
						</svg>
					</div>
					<h2 class="text-2xl font-bold tracking-tight">Sign in to MediaVault</h2>
					<p class="text-sm text-muted-foreground">Enter your credentials to access your media library</p>
				</div>

				<form class="space-y-4" hx-post="/api/auth/login" hx-target="#auth-response" hx-indicator="#spinner" hx-on::after-request="handleAuthResponse(event)">
					<div class="space-y-3">
						<div>
							<label for="email" class="block text-xs font-semibold uppercase tracking-wider mb-1.5 text-muted-foreground">Email</label>
							<input id="email" name="email" type="email" autocomplete="email" required 
								class="w-full px-4 py-3 bg-background border border-input rounded-xl text-foreground placeholder-muted-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring transition-all" placeholder="name@example.com"/>
						</div>
						<div>
							<label for="password" class="block text-xs font-semibold uppercase tracking-wider mb-1.5 text-muted-foreground">Password</label>
							<input id="password" name="password" type="password" autocomplete="current-password" required 
								class="w-full px-4 py-3 bg-background border border-input rounded-xl text-foreground placeholder-muted-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring transition-all" placeholder="••••••••"/>
						</div>
					</div>

					<div id="auth-response"></div>

					<div>
						<button type="submit" class="w-full flex items-center justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-xl text-primary-foreground bg-primary hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ring shadow-lg transition-all cursor-pointer">
							<span>Sign In</span>
							<svg id="spinner" class="htmx-indicator animate-spin ml-2 h-4 w-4 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</button>
					</div>

					<div class="text-center text-sm text-muted-foreground">
						Don't have an account? 
						<a href="/sign-up" class="font-semibold text-foreground hover:underline transition-colors">Create account</a>
					</div>
				</form>
			</div>
		</div>
		<script>
			function handleAuthResponse(evt) {
				const xhr = evt.detail.xhr;
				if (xhr.status >= 200 && xhr.status < 300) {
					window.location.href = '/';
				}
			}
		</script>
	}
}

templ SignUp() {
	@Base() {
		<div class="min-h-screen bg-background flex items-center justify-center p-4">
			<div class="max-w-md w-full bg-card border border-border rounded-3xl shadow-2xl p-8 space-y-6 text-card-foreground">
				<div class="text-center space-y-2">
					<div class="w-14 h-14 mx-auto bg-primary text-primary-foreground rounded-2xl shadow-md flex items-center justify-center">
						<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM3 20a6 6 0 0 1 12 0v1H3v-1Z"></path>
						</svg>
					</div>
					<h2 class="text-2xl font-bold tracking-tight">Create an Account</h2>
					<p class="text-sm text-muted-foreground">Set up your MediaVault server credentials</p>
				</div>

				<form class="space-y-4" hx-post="/api/auth/register" hx-target="#auth-response" hx-indicator="#spinner" hx-on::after-request="handleAuthResponse(event)">
					<div class="space-y-3">
						<div>
							<label for="email" class="block text-xs font-semibold uppercase tracking-wider mb-1.5 text-muted-foreground">Email</label>
							<input id="email" name="email" type="email" autocomplete="email" required 
								class="w-full px-4 py-3 bg-background border border-input rounded-xl text-foreground placeholder-muted-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring transition-all" placeholder="name@example.com"/>
						</div>
						<div>
							<label for="password" class="block text-xs font-semibold uppercase tracking-wider mb-1.5 text-muted-foreground">Password</label>
							<input id="password" name="password" type="password" autocomplete="new-password" required 
								class="w-full px-4 py-3 bg-background border border-input rounded-xl text-foreground placeholder-muted-foreground text-sm focus:outline-none focus:ring-2 focus:ring-ring transition-all" placeholder="••••••••"/>
							<p class="text-[11px] text-muted-foreground mt-1">Must be at least 8 characters with upper, lower, number & special character.</p>
						</div>
					</div>

					<div id="auth-response"></div>

					<div>
						<button type="submit" class="w-full flex items-center justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-xl text-primary-foreground bg-primary hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-ring shadow-lg transition-all cursor-pointer">
							<span>Create Account</span>
							<svg id="spinner" class="htmx-indicator animate-spin ml-2 h-4 w-4 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
								<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
								<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
							</svg>
						</button>
					</div>

					<div class="text-center text-sm text-muted-foreground">
						Already have an account? 
						<a href="/sign-in" class="font-semibold text-foreground hover:underline transition-colors">Sign in</a>
					</div>
				</form>
			</div>
		</div>
		<script>
			function handleAuthResponse(evt) {
				const xhr = evt.detail.xhr;
				if (xhr.status >= 200 && xhr.status < 300) {
					window.location.href = '/';
				}
			}
		</script>
	}
}
