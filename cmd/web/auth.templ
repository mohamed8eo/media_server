package web

import "github.com/bryanvaz/go-templ-lucide-icons"

templ SignUp() {
	@Base() {
		<div class="flex min-h-screen items-center justify-center bg-gradient-to-br from-sky-300 via-sky-100 to-indigo-200 p-3 dark:from-slate-950 dark:via-[#090d16] dark:to-indigo-950 sm:p-4">
			<div class="w-full max-w-md space-y-6 rounded-2xl border border-white/60 bg-white/95 p-5 text-slate-900 shadow-2xl backdrop-blur-xl dark:border-slate-800/80 dark:bg-[#0d1322]/95 dark:text-slate-100 sm:space-y-8 sm:rounded-3xl sm:p-8">
				<div class="text-center space-y-3">
					<div class="w-14 h-14 mx-auto bg-slate-100 dark:bg-slate-900 rounded-2xl shadow-md border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-800 dark:text-slate-200">
						@icons.UserPlus(templ.Attributes{"class": "w-6 h-6"})
					</div>
					<h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Create an account</h2>
					<p class="text-sm text-slate-500 dark:text-slate-400">Sign up to get started with your media server</p>
				</div>

				<form class="space-y-5" hx-post="/api/auth/register" hx-target="#auth-response" hx-swap="innerHTML" hx-indicator="#spinner" hx-on::after-request="handleAuthResponse(event)">
					<div class="space-y-4">
						<div>
							<label for="email" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1.5">Email</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									@icons.Mail(templ.Attributes{"class": "h-5 w-5"})
								</div>
								<input id="email" name="email" type="email" autocomplete="email" required 
									oninput="localStorage.setItem('auth_email', this.value)"
									class="w-full pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="name@example.com"/>
							</div>
						</div>
						<div>
							<label for="password" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1.5">Password</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									@icons.Lock(templ.Attributes{"class": "h-5 w-5"})
								</div>
								<input id="password" name="password" type="password" autocomplete="new-password" required 
									onfocus="document.getElementById('password-requirements').classList.remove('hidden')"
									oninput="checkPassword(this.value)"
									class="w-full pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="••••••••"/>
							</div>
							<div id="password-requirements" class="hidden mt-2 p-3.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-xl space-y-2 text-xs text-slate-600 dark:text-slate-400">
								<p class="font-semibold text-slate-700 dark:text-slate-300">Password requirements:</p>
								<div id="req-length" data-text="At least 8 characters" class="text-slate-400 flex items-center"><span class="text-slate-300 dark:text-slate-600 font-bold mr-1.5">○</span> At least 8 characters</div>
								<div id="req-upper" data-text="One uppercase letter (A-Z)" class="text-slate-400 flex items-center"><span class="text-slate-300 dark:text-slate-600 font-bold mr-1.5">○</span> One uppercase letter (A-Z)</div>
								<div id="req-lower" data-text="One lowercase letter (a-z)" class="text-slate-400 flex items-center"><span class="text-slate-300 dark:text-slate-600 font-bold mr-1.5">○</span> One lowercase letter (a-z)</div>
								<div id="req-special" data-text="One special character or number" class="text-slate-400 flex items-center"><span class="text-slate-300 dark:text-slate-600 font-bold mr-1.5">○</span> One special character or number</div>
							</div>
						</div>
					</div>

					<div id="inline-error" class="hidden text-xs font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-950/30 p-2.5 rounded-lg border border-red-100 dark:border-red-900/50 text-center"></div>

					<div>
						<button type="submit" class="w-full flex items-center justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-xl text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 dark:hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-lg shadow-indigo-500/15 transition-all cursor-pointer">
							<span>Create Account</span>
							@icons.Loader2(templ.Attributes{"id": "spinner", "class": "htmx-indicator animate-spin ml-2 h-4 w-4 text-white"})
						</button>
					</div>

					<div class="text-center text-sm text-slate-600 dark:text-slate-400">
						Already have an account? 
						<a href="/sign-in" class="font-semibold text-slate-900 dark:text-slate-200 hover:underline transition-colors">Sign in</a>
					</div>

					<div id="auth-response"></div>
				</form>
			</div>
		</div>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const savedEmail = localStorage.getItem('auth_email');
				if (savedEmail) {
					const emailInput = document.getElementById('email');
					if (emailInput) emailInput.value = savedEmail;
				}
			});

			function checkPassword(password) {
				const minLength = password.length >= 8;
				const hasUpper = /[A-Z]/.test(password);
				const hasLower = /[a-z]/.test(password);
				const hasSpecial = /[^A-Za-z0-9]/.test(password);

				updateReq('req-length', minLength);
				updateReq('req-upper', hasUpper);
				updateReq('req-lower', hasLower);
				updateReq('req-special', hasSpecial);
			}

			function updateReq(id, isValid) {
				const el = document.getElementById(id);
				if (!el) return;
				const text = el.getAttribute('data-text');
				if (isValid) {
					el.className = "text-emerald-600 font-medium flex items-center";
					el.innerHTML = '<span class="text-emerald-500 font-bold mr-1.5">✓</span> ' + text;
				} else {
					el.className = "text-slate-400 flex items-center";
					el.innerHTML = '<span class="text-slate-300 font-bold mr-1.5">○</span> ' + text;
				}
			}

			function handleAuthResponse(evt) {
				const xhr = evt.detail.xhr;
				const emailInput = document.getElementById('email');
				const passwordInput = document.getElementById('password');
				const inlineError = document.getElementById('inline-error');
				const authResponse = document.getElementById('auth-response');
				if (xhr.status >= 400) {
					if (emailInput) emailInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (passwordInput) passwordInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (inlineError) {
						const tempDiv = document.createElement('div');
						tempDiv.innerHTML = xhr.responseText;
						const span = tempDiv.querySelector('span');
						inlineError.textContent = span ? span.textContent : "Invalid email or password";
						inlineError.classList.remove('hidden');
					}
					// Keep a single error surface; don't leave a duplicate HTMX swap behind.
					if (authResponse) authResponse.innerHTML = '';
				} else {
					if (emailInput) {
						emailInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (passwordInput) {
						passwordInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (inlineError) {
						inlineError.textContent = '';
						inlineError.classList.add('hidden');
					}
					localStorage.removeItem('auth_email');
				}
			}
		</script>
	}
}

templ SignIn() {
	@Base() {
		<div class="flex min-h-screen items-center justify-center bg-gradient-to-br from-sky-300 via-sky-100 to-indigo-200 p-3 dark:from-slate-950 dark:via-[#090d16] dark:to-indigo-950 sm:p-4">
			<div class="w-full max-w-md space-y-6 rounded-2xl border border-white/60 bg-white/95 p-5 text-slate-900 shadow-2xl backdrop-blur-xl dark:border-slate-800/80 dark:bg-[#0d1322]/95 dark:text-slate-100 sm:space-y-8 sm:rounded-3xl sm:p-8">
				<div class="text-center space-y-3">
					<div class="w-14 h-14 mx-auto bg-slate-100 dark:bg-slate-900 rounded-2xl shadow-md border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-800 dark:text-slate-200">
						@icons.LogIn(templ.Attributes{"class": "w-6 h-6"})
					</div>
					<h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Sign in to your account</h2>
					<p class="text-sm text-slate-500 dark:text-slate-400">Welcome back! Please enter your details.</p>
				</div>

				<form class="space-y-5" hx-post="/api/auth/login" hx-target="#auth-response" hx-swap="innerHTML" hx-indicator="#spinner" hx-on::after-request="handleAuthResponse(event)">
					<div class="space-y-4">
						<div>
							<label for="email" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1.5">Email</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									@icons.Mail(templ.Attributes{"class": "h-5 w-5"})
								</div>
								<input id="email" name="email" type="email" autocomplete="email" required 
									oninput="localStorage.setItem('auth_email', this.value)"
									class="w-full pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="name@example.com"/>
							</div>
						</div>
						<div>
							<div class="flex items-center justify-between mb-1.5">
								<label for="password" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider">Password</label>
								<a href="/forgot-password" class="text-xs font-medium text-indigo-600 dark:text-indigo-400 hover:underline">Forgot password?</a>
							</div>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									@icons.Lock(templ.Attributes{"class": "h-5 w-5"})
								</div>
								<input id="password" name="password" type="password" autocomplete="current-password" required class="w-full pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="••••••••"/>
							</div>
						</div>
					</div>

					<div id="inline-error" class="hidden text-xs font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-950/30 p-2.5 rounded-lg border border-red-100 dark:border-red-900/50 text-center"></div>

					<div>
						<button type="submit" class="w-full flex items-center justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-xl text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 dark:hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-lg shadow-indigo-500/15 transition-all cursor-pointer">
							<span>Sign In</span>
							@icons.Loader2(templ.Attributes{"id": "spinner", "class": "htmx-indicator animate-spin ml-2 h-4 w-4 text-white"})
						</button>
					</div>

					<div class="text-center text-sm text-slate-600 dark:text-slate-400">
						Don't have an account? 
						<a href="/sign-up" class="font-semibold text-slate-900 dark:text-slate-200 hover:underline transition-colors">Create account</a>
					</div>

					<div id="auth-response"></div>
				</form>
			</div>
		</div>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const savedEmail = localStorage.getItem('auth_email');
				if (savedEmail) {
					const emailInput = document.getElementById('email');
					if (emailInput) emailInput.value = savedEmail;
				}
			});

			function handleAuthResponse(evt) {
				const xhr = evt.detail.xhr;
				const emailInput = document.getElementById('email');
				const passwordInput = document.getElementById('password');
				const inlineError = document.getElementById('inline-error');
				const authResponse = document.getElementById('auth-response');
				if (xhr.status >= 400) {
					if (emailInput) emailInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (passwordInput) passwordInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (inlineError) {
						const tempDiv = document.createElement('div');
						tempDiv.innerHTML = xhr.responseText;
						const span = tempDiv.querySelector('span');
						inlineError.textContent = span ? span.textContent : "Invalid email or password";
						inlineError.classList.remove('hidden');
					}
					// Keep a single error surface; don't leave a duplicate HTMX swap behind.
					if (authResponse) authResponse.innerHTML = '';
				} else {
					if (emailInput) {
						emailInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (passwordInput) {
						passwordInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (inlineError) {
						inlineError.textContent = '';
						inlineError.classList.add('hidden');
					}
					localStorage.removeItem('auth_email');
				}
			}
		</script>
	}
}

templ ForgotPassword() {
	@Base() {
		<div class="flex min-h-screen items-center justify-center bg-gradient-to-br from-sky-300 via-sky-100 to-indigo-200 p-3 dark:from-slate-950 dark:via-[#090d16] dark:to-indigo-950 sm:p-4">
			<div class="w-full max-w-md space-y-6 rounded-2xl border border-white/60 bg-white/95 p-5 text-slate-900 shadow-2xl backdrop-blur-xl dark:border-slate-800/80 dark:bg-[#0d1322]/95 dark:text-slate-100 sm:space-y-8 sm:rounded-3xl sm:p-8">
				<div class="text-center space-y-3">
					<div class="w-14 h-14 mx-auto bg-slate-100 dark:bg-slate-900 rounded-2xl shadow-md border border-slate-200 dark:border-slate-800 flex items-center justify-center text-slate-800 dark:text-slate-200">
						@icons.Key(templ.Attributes{"class": "w-6 h-6"})
					</div>
					<h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-slate-100">Reset your password</h2>
					<p class="text-sm text-slate-500 dark:text-slate-400">Enter your email and choose a new password.</p>
				</div>

				<form class="space-y-5" hx-post="/api/auth/reset-password" hx-target="#auth-response" hx-swap="innerHTML" hx-indicator="#spinner" hx-on::after-request="handleAuthResponse(event)">
					<div class="space-y-4">
						<div>
							<label for="email" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1.5">Email</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									@icons.Mail(templ.Attributes{"class": "h-5 w-5"})
								</div>
								<input id="email" name="email" type="email" autocomplete="email" required 
									oninput="localStorage.setItem('auth_email', this.value)"
									class="w-full pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="name@example.com"/>
							</div>
						</div>
						<div>
							<label for="password" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-wider mb-1.5">New Password</label>
							<div class="relative rounded-xl shadow-sm">
								<div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
									@icons.Lock(templ.Attributes{"class": "h-5 w-5"})
								</div>
								<input id="password" name="password" type="password" autocomplete="new-password" required 
									onfocus="document.getElementById('password-requirements').classList.remove('hidden')"
									oninput="checkPassword(this.value)"
									class="w-full pl-11 pr-4 py-3 bg-slate-50 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-900 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" placeholder="••••••••"/>
							</div>
							<div id="password-requirements" class="hidden mt-2 p-3.5 bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 rounded-xl space-y-2 text-xs text-slate-600 dark:text-slate-400">
								<p class="font-semibold text-slate-700 dark:text-slate-300">Password requirements:</p>
								<div id="req-length" data-text="At least 8 characters" class="text-slate-400 flex items-center"><span class="text-slate-300 dark:text-slate-600 font-bold mr-1.5">○</span> At least 8 characters</div>
								<div id="req-upper" data-text="One uppercase letter (A-Z)" class="text-slate-400 flex items-center"><span class="text-slate-300 dark:text-slate-600 font-bold mr-1.5">○</span> One uppercase letter (A-Z)</div>
								<div id="req-lower" data-text="One lowercase letter (a-z)" class="text-slate-400 flex items-center"><span class="text-slate-300 dark:text-slate-600 font-bold mr-1.5">○</span> One lowercase letter (a-z)</div>
								<div id="req-special" data-text="One special character or number" class="text-slate-400 flex items-center"><span class="text-slate-300 dark:text-slate-600 font-bold mr-1.5">○</span> One special character or number</div>
							</div>
						</div>
					</div>

					<div id="inline-error" class="hidden text-xs font-medium text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-950/30 p-2.5 rounded-lg border border-red-100 dark:border-red-900/50 text-center"></div>

					<div>
						<button type="submit" class="w-full flex items-center justify-center py-3 px-4 border border-transparent text-sm font-semibold rounded-xl text-white bg-slate-900 dark:bg-indigo-600 hover:bg-slate-800 dark:hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 shadow-lg shadow-indigo-500/15 transition-all cursor-pointer">
							<span>Reset Password</span>
							@icons.Loader2(templ.Attributes{"id": "spinner", "class": "htmx-indicator animate-spin ml-2 h-4 w-4 text-white"})
						</button>
					</div>

					<div class="text-center text-sm text-slate-600 dark:text-slate-400">
						Remember your password? 
						<a href="/sign-in" class="font-semibold text-slate-900 dark:text-slate-200 hover:underline transition-colors">Sign in</a>
					</div>

					<div id="auth-response"></div>
				</form>
			</div>
		</div>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const savedEmail = localStorage.getItem('auth_email');
				if (savedEmail) {
					const emailInput = document.getElementById('email');
					if (emailInput) emailInput.value = savedEmail;
				}
			});

			function checkPassword(password) {
				const minLength = password.length >= 8;
				const hasUpper = /[A-Z]/.test(password);
				const hasLower = /[a-z]/.test(password);
				const hasSpecial = /[^A-Za-z0-9]/.test(password);

				updateReq('req-length', minLength);
				updateReq('req-upper', hasUpper);
				updateReq('req-lower', hasLower);
				updateReq('req-special', hasSpecial);
			}

			function updateReq(id, isValid) {
				const el = document.getElementById(id);
				if (!el) return;
				const text = el.getAttribute('data-text');
				if (isValid) {
					el.className = "text-emerald-600 font-medium flex items-center";
					el.innerHTML = '<span class="text-emerald-500 font-bold mr-1.5">✓</span> ' + text;
				} else {
					el.className = "text-slate-400 flex items-center";
					el.innerHTML = '<span class="text-slate-300 font-bold mr-1.5">○</span> ' + text;
				}
			}

			function handleAuthResponse(evt) {
				const xhr = evt.detail.xhr;
				const emailInput = document.getElementById('email');
				const passwordInput = document.getElementById('password');
				const inlineError = document.getElementById('inline-error');
				const authResponse = document.getElementById('auth-response');
				if (xhr.status >= 400) {
					if (emailInput) emailInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (passwordInput) passwordInput.classList.add('border-red-500', 'ring-1', 'ring-red-500');
					if (inlineError) {
						const tempDiv = document.createElement('div');
						tempDiv.innerHTML = xhr.responseText;
						const span = tempDiv.querySelector('span');
						inlineError.textContent = span ? span.textContent : "Failed to reset password";
						inlineError.classList.remove('hidden');
					}
					if (authResponse) authResponse.innerHTML = '';
				} else {
					if (emailInput) {
						emailInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (passwordInput) {
						passwordInput.classList.remove('border-red-500', 'ring-1', 'ring-red-500');
					}
					if (inlineError) {
						inlineError.textContent = '';
						inlineError.classList.add('hidden');
					}
					localStorage.removeItem('auth_email');
				}
			}
		</script>
	}
}
