package web

templ Browser() {
	<div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-6">
		<!-- Sidebar: Folders -->
		<div class="space-y-4">
			<div class="rounded-xl border bg-card text-card-foreground shadow-sm p-4 space-y-3">
				<div class="flex items-center justify-between">
					<h3 class="text-sm font-semibold leading-none tracking-tight">Folders</h3>
					<button onclick="createNewFolder()" class="inline-flex items-center justify-center gap-1.5 whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-8 px-3">
						<svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
						New
					</button>
				</div>
				<div id="folder-list" class="space-y-1"></div>
			</div>
		</div>

		<!-- Files Area -->
		<div class="md:col-span-3 space-y-4">
			<!-- Breadcrumbs -->
			<div id="breadcrumbs" class="flex items-center gap-1 rounded-xl border bg-card text-card-foreground shadow-sm px-4 py-3">
				<span class="text-sm font-medium">My files</span>
			</div>

			<!-- Toolbar -->
			<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 rounded-xl border bg-card text-card-foreground shadow-sm p-4">
				<div class="relative flex-1 max-w-sm">
					<svg class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
					<input type="text" id="file-search" placeholder="Search files..."
						class="flex h-9 w-full rounded-md border border-input bg-transparent pl-9 pr-4 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
				</div>
				<div class="flex items-center gap-2">
					<span id="file-count" class="text-xs text-muted-foreground mr-1"></span>
					<select id="file-sort" class="flex h-9 items-center justify-between whitespace-nowrap rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm ring-offset-background focus:outline-none focus:ring-1 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-50 [&>span]:line-clamp-1">
						<option value="date-desc">Newest</option>
						<option value="date-asc">Oldest</option>
						<option value="name-asc">Name A-Z</option>
						<option value="name-desc">Name Z-A</option>
						<option value="size-desc">Largest</option>
						<option value="size-asc">Smallest</option>
					</select>
					<div class="flex items-center border rounded-md p-0.5">
						<button id="view-grid" onclick="setFileView('grid')" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-sm text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-7 w-7" title="Grid view">
							<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-16zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-16z"></path></svg>
						</button>
						<button id="view-list" onclick="setFileView('list')" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-sm text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground h-7 w-7" title="List view">
							<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
						</button>
					</div>
				</div>
			</div>

			<!-- File Container -->
			<div id="file-container">
				<div id="file-loading" class="flex flex-col items-center justify-center py-20 text-muted-foreground">
					<svg class="animate-spin h-8 w-8 mb-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
					<p class="text-sm">Loading your files...</p>
				</div>

				<div id="file-empty" class="hidden flex flex-col items-center justify-center rounded-xl border border-dashed p-12 text-center">
					<div class="flex h-20 w-20 items-center justify-center rounded-full bg-muted">
						<svg class="h-10 w-10 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path></svg>
					</div>
					<h3 class="mt-4 text-lg font-semibold">No files here</h3>
					<p class="mb-4 mt-2 text-sm text-muted-foreground">Upload files or create a subfolder to get started.</p>
					<div class="flex items-center gap-2">
						<a href="/upload" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-4 py-2">
							<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
							Upload
						</a>
						<button onclick="createNewFolder()" class="inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-colors border border-input bg-background shadow-sm hover:bg-accent hover:text-accent-foreground h-9 px-4 py-2">
							<svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
							New folder
						</button>
					</div>
				</div>

				<div id="file-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
				<div id="file-list" class="hidden rounded-xl border bg-card text-card-foreground shadow-sm overflow-hidden"></div>
			</div>
		</div>
	</div>
}
