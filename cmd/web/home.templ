package web

templ HomeContent() {
	<div class="space-y-4">
		@Browser("all")
	</div>
}

templ Home() {
	@AppShell("all", "", "") {
		@HomeContent()
		<script src={ "/assets/js/browser.js?v=" + AssetVersion }></script>
		<script src={ "/assets/js/upload.js?v=" + AssetVersion }></script>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				initFileBrowser();
			});
		</script>
	}
}
