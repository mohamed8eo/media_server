package web

import "github.com/bryanvaz/go-templ-lucide-icons"

templ Home() {
	@AppShell("home") {
		<div class="space-y-4">
			<!-- Drop overlay -->
			<div id="drop-overlay" class="fixed inset-0 z-50 bg-background/80 backdrop-blur-sm hidden items-center justify-center">
				<div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-primary bg-background p-12 shadow-lg space-y-4 max-w-lg w-full mx-4 animate-content-show">
					<div class="flex h-16 w-16 items-center justify-center rounded-full bg-muted animate-bounce">
						@icons.Upload(templ.Attributes{"class": "h-8 w-8 text-muted-foreground"})
					</div>
					<h3 class="text-lg font-semibold">Drop files to upload</h3>
					<p class="text-sm text-muted-foreground">Files will be added instantly to your workspace</p>
				</div>
			</div>

			@Browser()
		</div>

		<script src="/assets/js/browser.js"></script>
		<script src="/assets/js/upload.js"></script>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				initFileBrowser();
				setupDropOverlay();
			});
		</script>
	}
}
