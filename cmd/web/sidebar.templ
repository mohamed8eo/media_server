package web

import "github.com/bryanvaz/go-templ-lucide-icons"

templ Sidebar(currentPage string) {
	<aside class="fixed inset-y-0 left-0 z-50 flex w-64 flex-col border-r bg-card border-border dark:bg-[#0d1322] dark:border-slate-800/80">
		<!-- Logo -->
		<div class="flex h-14 items-center gap-2.5 border-b px-5 border-border dark:border-slate-800/80">
			<div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-sm">
				@icons.Play(templ.Attributes{"class": "h-4 w-4"})
			</div>
			<span class="text-lg font-bold tracking-tight text-slate-900 dark:text-slate-100">MediaVault</span>
		</div>
		<!-- Navigation -->
		<nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1.5" id="sidebar-nav">
			<a href="/" data-nav="all" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
				@icons.Library(templ.Attributes{"class": "h-4 w-4"})
				All Media
			</a>
			<a href="/?type=video" data-nav="video" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
				@icons.Video(templ.Attributes{"class": "h-4 w-4"})
				Videos
			</a>
			<a href="/?type=image" data-nav="image" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
				@icons.Image(templ.Attributes{"class": "h-4 w-4"})
				Images
			</a>
			<a href="/?type=document" data-nav="document" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
				@icons.FileText(templ.Attributes{"class": "h-4 w-4"})
				Documents
			</a>
			<a href="/upload" data-nav="upload" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
				@icons.Upload(templ.Attributes{"class": "h-4 w-4"})
				Upload
			</a>
			<a href="/?trash=1" data-nav="trash" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
				@icons.Trash2(templ.Attributes{"class": "h-4 w-4"})
				Recycle Bin
			</a>
		</nav>
		<!-- Bottom Section -->
		<div class="border-t px-3 py-4 space-y-1 border-border dark:border-slate-800/80">
			<a href="/settings" data-nav="settings" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100">
				@icons.Settings(templ.Attributes{"class": "h-4 w-4"})
				Settings
			</a>
		</div>
	</aside>
	<script>
		function updateSidebarActive() {
			const params = new URLSearchParams(window.location.search);
			const type = params.get('type');
			const path = window.location.pathname;
			let active = 'all';
			if (path === '/upload') active = 'upload';
			else if (path === '/settings') active = 'settings';
			else if (type === 'video') active = 'video';
			else if (type === 'image') active = 'image';
			else if (type === 'document') active = 'document';
			else if (params.get('trash') === '1') active = 'trash';
			document.querySelectorAll('#sidebar-nav a[data-nav], [data-nav]').forEach(link => {
				if (link.dataset.nav === active) {
					link.className = 'flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors bg-slate-100 dark:bg-slate-800/80 text-slate-900 dark:text-slate-100 font-semibold shadow-sm';
				} else {
					link.className = 'flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-slate-100';
				}
			});
		}
		updateSidebarActive();
		window.addEventListener('popstate', updateSidebarActive);
	</script>
}
