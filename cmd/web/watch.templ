package web

import (
	"mediaserver/internal/models"
)

templ Watch(file models.File) {
	@AppShell("watch", "", "") {
		<section id="watch-page" data-video-id={ file.ID.String() } class="space-y-0">
			<div class="mb-5 flex justify-end gap-2 sm:mb-6">
				<a href={ templ.URL("/?type=video&folder=" + file.Folder) } class="inline-flex items-center gap-2 rounded-xl bg-secondary px-3.5 py-2 text-sm font-medium text-secondary-foreground shadow-sm transition-colors hover:bg-secondary/80">
					<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg>
					<span class="hidden sm:inline">Back to Videos</span>
				</a>
				<a id="watch-download" href={ templ.URL("/api/file/" + file.ID.String()) } download class="inline-flex items-center gap-2 rounded-xl bg-primary px-3.5 py-2 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90">
					<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5M12 15V3"/></svg>
					<span class="hidden sm:inline">Download</span>
				</a>
			</div>

			<div class="grid min-w-0 gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
				<section class="min-w-0">
					<div class="overflow-hidden rounded-xl bg-black shadow-2xl">
						<video id="watch-player" controls preload="metadata" src={ templ.URL("/api/file/" + file.ID.String()) } class="aspect-video w-full bg-black"></video>
					</div>
					<div class="mt-5 flex flex-wrap items-start justify-between gap-3">
						<div class="min-w-0">
							<h1 id="watch-title" class="truncate text-xl font-bold sm:text-2xl">{ file.DisplayName() }</h1>
							<p id="watch-meta" class="mt-2 text-sm text-muted-foreground">{ file.SizeFormatted() } &middot; Trove { file.Folder }</p>
						</div>
						<span id="watch-badge" class="shrink-0 rounded-lg bg-accent px-2.5 py-1.5 text-xs font-bold text-accent-foreground">{ file.TypeBadge() }</span>
					</div>
				</section>

				<aside>
					<h2 class="mb-3 font-bold">More in this folder</h2>
					<div id="watch-queue" class="max-h-[620px] space-y-1 overflow-y-auto rounded-xl border border-border bg-card p-2 shadow-sm"></div>
				</aside>
			</div>
		</section>
		<script src={ "/assets/js/watch.js?v=" + AssetVersion }></script>
	}
}

templ WatchUnavailable() {
	@AppShell("watch", "", "") {
		<section class="mx-auto flex max-w-lg flex-col items-center rounded-2xl border border-dashed border-border bg-card/50 px-6 py-20 text-center">
			<div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-muted text-muted-foreground">
				<svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M15 10 21 7v10l-6-3"/><rect width="15" height="14" x="3" y="5" rx="2"/></svg>
			</div>
			<h1 class="mt-4 text-xl font-bold">Video unavailable</h1>
			<p class="mt-2 text-sm text-muted-foreground">This video does not exist, is not a video, or you do not have access to it.</p>
			<a href="/?type=video" class="mt-6 rounded-xl bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow hover:bg-primary/90">Back to Videos</a>
		</section>
	}
}
